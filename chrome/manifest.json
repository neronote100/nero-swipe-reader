{
  "manifest_version": 3,
  "name": "NERO Swipe Reader",
  "version": "0.5.1",
  "description": "ウォッチリストをスワイプで読み、noteのログイン状態でスキ・コメント・未返信管理ができるメンバー向けリーダー。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://note.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "NERO Swipe Readerを開く",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://note.com; img-src 'self' https: data:; style-src 'self'; frame-src 'none'"
  }
}
